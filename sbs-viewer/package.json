{
  "name": "sbs-viewer",
  "version": "1.0.0",
  "description": "SBS Viewer — standalone player for .sbsproc / .sbsasm files",
  "main": "main.js",
  "scripts": {
    "start":          "electron .",
    "bytenode":       "node scripts/build-bytenode.js",
    "bytenode:clean": "node scripts/build-bytenode.js --clean",
    "build":          "npm run bytenode && electron-builder",
    "build:nobytenode": "electron-builder",
    "build:win":      "npm run bytenode && electron-builder --win",
    "build:mac":      "npm run bytenode && electron-builder --mac",
    "build:linux":    "npm run bytenode && electron-builder --linux",
    "build:customer": "node scripts/build-installer.js"
  },
  "build": {
    "appId": "com.sbs.viewer",
    "productName": "SBS Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "company.js",
      "license/**/*",
      "viewer.html",
      "viewer.js",
      "styles.css",
      "sample.sbsasm",
      "package.json",
      "!license/verify.js",
      "!license/machine-id.js",
      "!license/store.js",
      "!license/index.js",
      "!license/time-monitor.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "SBS-Viewer-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "bytenode": "^1.5.7"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
