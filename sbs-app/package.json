{
  "name": "sbs-step-browser",
  "version": "0.3.2-136",
  "description": "SBS Step Browser — CAD Presentation Tool",
  "author": "SBS Step Browser",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "bytenode": "node scripts/build-bytenode.js",
    "bytenode:clean": "node scripts/build-bytenode.js --clean",
    "ensure-models": "node scripts/ensure-kokoro-bundle.js",
    "vendor-tts": "node scripts/vendor-tts-webgpu.js",
    "sanitize-sbom": "node scripts/sanitize-sbom.js",
    "build": "npm run ensure-models && npm run vendor-tts && npm run bytenode && npm run sanitize-sbom && electron-builder",
    "build:he": "npm run ensure-models && npm run vendor-tts && npm run bytenode && npm run sanitize-sbom && electron-builder --config electron-builder-he.js",
    "build:nobytenode": "npm run ensure-models && npm run vendor-tts && npm run sanitize-sbom && electron-builder",
    "fetch-models": "node scripts/fetch-kokoro.js"
  },
  "overrides": {
    "protobufjs": "8.7.1",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8"
  },
  "build": {
    "appId": "com.sbs.stepbrowser",
    "productName": "SBS Step Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "assets/eula.txt"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "sbs_license/**/*",
      "!sbs_license/keys/**",
      "!sbs_license/issued_licenses/**",
      "!sbs_license/__pycache__/**",
      "!sbs_license/SBS-keys.zip",
      "!scripts/build-bytenode.js",
      "!scripts/bytenode-compile-worker.js",
      "!electron/license/verify.js",
      "!electron/license/machine-id.js",
      "!electron/license/store.js",
      "!electron/license/index.js",
      "!electron/license/time-monitor.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/**/*.{md,markdown}",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,__tests__}",
      "!**/{.eslintrc,.eslintignore,.babelrc}"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "vendor/ort/**/*",
      "vendor/kokoro.web.js"
    ],
    "extraResources": [
      {
        "from": "tools/stitch/bin",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      },
      {
        "from": "kokoro-bundle",
        "to": "kokoro-bundle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/bin",
        "to": "native/bin",
        "filter": [
          "**/*",
          "!**/*.sbsobj",
          "!**/*.sbsmesh",
          "!**/*.{step,stp,STEP,STP,iges,igs,IGES,IGS}",
          "!**/PLACEHOLDER.txt"
        ]
      }
    ]
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "kokoro-js": "^1.2.1",
    "say": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3"
  }
}
