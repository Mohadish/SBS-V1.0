# Dependencies
node_modules/
sbs-app/node_modules/
.venv/
piper_shared/.venv/
piper_shared/voices/
step_export_helper_v0.148/ffmpeg/

# Build outputs
dist/
build/
out/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Cache
.cache/
.parcel-cache/
.vite/

# Claude per-user settings (paths are local)
.claude/settings.local.json

# Kokoro model bundle — fetched on demand via `npm run fetch-models`.
# 110 MB binary blob, would balloon git history. electron-builder picks
# it up via build.extraResources at packaging time.
sbs-app/kokoro-bundle/

# User-project saves — large binary CAD files (FBX, GLB, STEP) + per-user
# .sbsproj scratch files. Should never have been tracked. Files stay on
# disk locally; new ones won't enter git.
saves/

# Viewer test artifacts dropped by hand into the viewer folder.
sbs-viewer/*.sbsasm
sbs-viewer/*.sbsproc

# License signing artifacts — keys MUST NEVER be committed. Real keys
# live in ~/.sbs_license/keys/ (see sbs_license/keygen.py). This entry
# is belt-and-suspenders in case someone runs --init-keys with a
# SBS_LICENSE_KEYS_DIR override that points back into the repo.
sbs_license/keys/
sbs_license/issued_licenses/
sbs_license/*.zip
__pycache__/

# Bytenode build artifacts — compiled .jsc files for the license module
# are produced fresh by `npm run bytenode` (which `npm run build` calls
# automatically). Never committed; ephemeral per build.
sbs-app/electron/license/*.jsc
