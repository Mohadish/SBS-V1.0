# Dependencies
node_modules/
sbs-app/node_modules/
.venv/
piper_shared/.venv/
piper_shared/voices/
step_export_helper_v0.148/ffmpeg/

# Build outputs
dist/
build/
out/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Cache
.cache/
.parcel-cache/
.vite/

# Claude Code per-machine state (worktrees, session metadata, settings).
# Entire directory is local-only — never useful to other collaborators.
.claude/

# Kokoro model bundle — fetched on demand via `npm run fetch-models`.
# 110 MB binary blob, would balloon git history. electron-builder picks
# it up via build.extraResources at packaging time.
sbs-app/kokoro-bundle/

# WebGPU-Kokoro vendored assets — regenerated (+ patched) from node_modules by
# `npm run vendor-tts`. The wasm is ~21 MB; the bundle is patched, so it must be
# produced by the script, not committed. Build runs vendor-tts automatically.
sbs-app/vendor/kokoro.web.js
sbs-app/vendor/ort/

# User-project saves — large binary CAD files (FBX, GLB, STEP) + per-user
# .sbsproj scratch files. Should never have been tracked. Files stay on
# disk locally; new ones won't enter git.
saves/

# Viewer test artifacts dropped by hand into the viewer folder.
sbs-viewer/*.sbsasm
sbs-viewer/*.sbsproc

# License signing artifacts — keys MUST NEVER be committed. Real keys
# live in ~/.sbs_license/keys/ (see sbs_license/keygen.py). This entry
# is belt-and-suspenders in case someone runs --init-keys with a
# SBS_LICENSE_KEYS_DIR override that points back into the repo.
sbs_license/keys/
sbs_license/issued_licenses/
sbs_license/*.zip
__pycache__/

# Bytenode build artifacts — compiled .jsc files for the license module
# are produced fresh by `npm run bytenode` (which `npm run build` calls
# automatically). Never committed; ephemeral per build.
sbs-app/electron/license/*.jsc

# SBS Viewer build artifacts.
# - `license/*.jsc` are bytenode bytecode (regenerated by `npm run bytenode`).
# - `dist/` holds the customer installers — large, ephemeral per build.
# - `node_modules/` covered by global rule but listed for clarity.
sbs-viewer/license/*.jsc
sbs-viewer/dist/
sbs-viewer/node_modules/

# TTS diagnostic temp dumps (written by window.sbsTTS.dumpText / sbsTTSDiag)
tts-diag.json
tts-textdump.json

# Hebrew Kokoro test add-on — NON-COMMERCIAL model (SASPEECH/IPBC).
# 605 MB, and must never be committed or shipped in a commercial build.
# Populated from E:\hebrew-tts-spike. See scripts/fetch-kokoro-he.js.
sbs-app/kokoro-he/
sbs-app/out-he-test/
sbs-app/dist-he/
